{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "AgroCreditoApi",
    "Audience": "AgroCreditoApi",
    "ExpirationMinutes": 60
  },
  "RateLimiting": {
    "Global": { "PermitLimit": 100, "WindowSeconds": 60 },
    "Auth": { "PermitLimit": 10, "WindowSeconds": 60 }
  },
  "HealthChecks": {
    "ExternalService": {
      "Name": "Banco Central do Brasil (API pública)",
      "Url": "https://api.bcb.gov.br/dados/serie/bcdata.sgs.432/dados/ultimos/1?formato=json",
      "TimeoutSeconds": 5
    }
  }
}
